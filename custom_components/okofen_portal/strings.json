{
  "config": {
    "step": {
      "user": {
        "title": "ÖkoFEN portal",
        "description": "Sign in with your my.oekofen.info account. Optionally add the controller's local address (e.g. 192.168.0.10) and its local password, or paste the full URL shown by the Touch (http://192.168.0.10:4321/PASSWORD/all): the fast values are then read locally every 10 s and the portal is only used for the rest.",
        "data": {
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]",
          "local_host": "Local address or full URL (optional)",
          "local_password": "Local password (optional)"
        }
      },
      "reauth_confirm": {
        "title": "Sign in again",
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "reconfigure": {
        "title": "Change the account",
        "description": "The installation must stay the same. Leave the local address empty to use the portal only.",
        "data": {
          "username": "Username",
          "password": "Password",
          "local_host": "Local address or full URL (optional)",
          "local_password": "Local password (optional)"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "cannot_connect_local": "Could not reach the local interface (address, port 4321 and local password)"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "reconfigure_successful": "Re-configuration was successful",
      "unique_id_mismatch": "This account belongs to another installation"
    }
  },
