      "init": {
        "title": "Solar boost",
        "description": "On sunny days, raise the comfort setpoint as far as the buffer can supply without the boiler, to store solar heat in the house. Not when someone is home; when everyone is far away, only the surplus. The boost stops as soon as the burner starts, the buffer or the hot water gets too cold, someone comes home, or the setpoint is changed by hand.",
        "data": {
          "target": "Highest comfort setpoint while boosting",
          "tank_threshold": "Buffer top needed at least to start (empty: from the heating curve)",
